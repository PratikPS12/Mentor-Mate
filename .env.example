# ==============================================================================
# MENTOR MATE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit .env or paste production secrets into source control.

NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB Atlas connection string (or leave empty to use embedded local database engine)
MONGODB_URI=
DATABASE_NAME=mentor_mate_db

# Redis connection URL for background jobs (optional in dev)
REDIS_URL=redis://127.0.0.1:6379/0

# Object storage / local uploads
UPLOAD_DIR=data/uploads

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION (AGENTROUTER / OPENAI-COMPATIBLE)
# ------------------------------------------------------------------------------
# Supported providers: agentrouter, openai, local_fallback
AI_PROVIDER=agentrouter
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_API_KEY=PASTE_YOUR_AGENTROUTER_KEY_HERE

# Model Routing Configuration
# Models available to your key can be verified via the /api/v1/ai/health endpoint
AI_MODEL_PRIMARY=gpt-4o
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_REASONING=o1
AI_MODEL_VISION=gpt-4o
AI_MODEL_FALLBACK=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
